// Schéma de données de la plateforme Access.
// Conventions : identifiants cuid, montants en francs CFA (entiers), dates en UTC.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Comptes et sécurité
// ---------------------------------------------------------------------------

enum Role {
  PARENT
  EDUCATOR
  // Tuteur seul. Un éducateur peut aussi être tuteur : c'est la fiche TutorProfile qui ouvre l'espace tuteur.
  TUTOR
  ADMIN
}

// SUSPENDED : sanction temporaire ; DEACTIVATED : compte fermé. Les deux interdisent la connexion.
enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id                 String        @id @default(cuid())
  npi                String        @unique
  email              String        @unique
  phone              String        @unique
  firstName          String
  lastName           String
  passwordHash       String
  role               Role
  isSuperAdmin       Boolean       @default(false)
  status             AccountStatus @default(ACTIVE)
  // Échecs de connexion consécutifs ; au 5e, le compte est verrouillé 24 h (seul un administrateur peut le lever avant).
  failedLogins       Int           @default(0)
  lockedUntil        DateTime?
  // Mot de passe provisoire fixé par un administrateur : à remplacer à la prochaine connexion.
  mustChangePassword Boolean       @default(false)
  address            String?
  city               String?
  lastLoginAt        DateTime?
  acceptedTermsAt    DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  sessions             Session[]
  resetTokens          PasswordResetToken[]
  educatorProfile      EducatorProfile?
  children             Child[]
  parentTutorings      Tutoring[]           @relation("ParentTutorings")
  complaints           Complaint[]          @relation("ComplaintAuthor")
  handledComplaints    Complaint[]          @relation("ComplaintHandler")
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  payments             Payment[]            @relation("PaymentPayer")
  resolvedPayments     Payment[]            @relation("PaymentAnomalyResolver")
  refundedInstallments Installment[]        @relation("InstallmentRefunder")
  reviews              Review[]
  auditLogs            AuditLog[]
  executedPayouts      Payout[]             @relation("PayoutExecutor")
  validatedProfiles    EducatorProfile[]    @relation("ProfileValidator")
  tutorProfile         TutorProfile?
  validatedTutors      TutorProfile[]       @relation("TutorValidator")
  parentFollowUps      FollowUp[]           @relation("ParentFollowUps")
}

// Session côté serveur : le cookie ne contient qu'un jeton opaque, la base n'en stocke que l'empreinte SHA-256.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  // false : « Rester connecté » décoché, la session s'arrête à la fermeture du navigateur.
  persistent Boolean  @default(true)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Éducateurs
// ---------------------------------------------------------------------------

// Opérateur Mobile Money des reversements à l'éducateur.
enum MobileOperator {
  MTN
  MOOV
}

enum ProfileStatus {
  INCOMPLETE
  SUBMITTED
  VALIDATED
  REJECTED
}

enum DocumentType {
  ID_CARD
  CRIMINAL_RECORD
  ACADEMIC_DIPLOMA
  PROFESSIONAL_DIPLOMA
  PHOTO
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimeSlot {
  S08_11
  S11_14
  S14_17
  S17_20
}

model EducatorProfile {
  id                String          @id @default(cuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate         DateTime?
  maritalStatus     String?
  experienceYears   Int?
  // Texte libre des anciens dossiers ; remplacé par le parcours détaillé ci-dessous.
  background        String?
  degreeLevel       String?
  degreeField       String?
  degreeSchool      String?
  degreeYear        Int?
  occupation        String?
  occupationPlace   String?
  // Expériences d'enseignement : [{ place, role, from, to? }].
  experiences       Json?
  achievements      String?
  bio               String?
  subjects          String[]
  // Cycles choisis par l'éducateur, modifiables par l'administrateur à la validation.
  cycles            String[]        @default([])
  classLevels       String[]
  zone              String?
  guarantor1Name    String?
  guarantor1Address String?
  guarantor1Phone   String?
  guarantor2Name    String?
  guarantor2Address String?
  guarantor2Phone   String?
  payoutPhone       String?
  payoutOperator    MobileOperator?
  status            ProfileStatus   @default(INCOMPLETE)
  level             String?
  stars             Int?
  rejectionReason   String?
  submittedAt       DateTime?
  validatedAt       DateTime?
  validatedById     String?
  validatedBy       User?           @relation("ProfileValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  documents      EducatorDocument[]
  availabilities Availability[]
  tutorings      Tutoring[]
  bookedSlots    BookedSlot[]
  reviews        Review[]
  payouts        Payout[]

  @@index([status])
}

model EducatorDocument {
  id           String          @id @default(cuid())
  educatorId   String
  educator     EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  type         DocumentType
  storageKey   String          @unique
  mimeType     String
  size         Int
  originalName String
  uploadedAt   DateTime        @default(now())

  @@unique([educatorId, type])
}

model Availability {
  id         String          @id @default(cuid())
  educatorId String
  educator   EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  day        Weekday
  slot       TimeSlot

  @@unique([educatorId, day, slot])
}

// ---------------------------------------------------------------------------
// Enfants
// ---------------------------------------------------------------------------

enum Sex {
  F
  M
}

enum SubjectLevelValue {
  WEAK
  AVERAGE
  GOOD
  VERY_GOOD
}

model Child {
  id               String   @id @default(cuid())
  parentId         String
  parent           User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  npi              String?  @unique
  firstName        String
  lastName         String
  sex              Sex
  birthDate        DateTime
  previousClass    String?
  previousSchool   String?
  currentClass     String
  currentSchool    String?
  favoriteSubjects String?
  interests        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subjectLevels SubjectLevel[]
  tutorings     Tutoring[]
  followUps     FollowUpChild[]
  occurrences   TaskOccurrence[]

  @@index([parentId])
}

model SubjectLevel {
  id      String            @id @default(cuid())
  childId String
  child   Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  subject String
  level   SubjectLevelValue

  @@unique([childId, subject])
}

// ---------------------------------------------------------------------------
// Référentiel scolaire, géré depuis l'administration
// ---------------------------------------------------------------------------

// Les autres tables désignent une classe par son nom et une matière par sa clé (texte) :
// renommer une classe met ces valeurs à jour ; la clé d'une matière ne change jamais.
// Une classe ou une matière désactivée n'est plus proposée, mais les données existantes restent lisibles.
model ClassLevel {
  id        String              @id @default(cuid())
  name      String              @unique
  position  Int
  // Primaire, Secondaire 1 ou Secondaire 2 (voir CYCLES dans src/lib/constants.ts).
  cycle     String              @default("Secondaire 1")
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  subjects  ClassLevelSubject[]
}

model Subject {
  id          String              @id @default(cuid())
  key         String              @unique
  label       String
  position    Int
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  classLevels ClassLevelSubject[]
}

// Matières évaluées dans une classe (niveau de l'enfant renseigné par le parent).
model ClassLevelSubject {
  classLevelId String
  classLevel   ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([classLevelId, subjectId])
  @@index([subjectId])
}

// ---------------------------------------------------------------------------
// Tarifs, tutorats, séances
// ---------------------------------------------------------------------------

model Tariff {
  id              String   @id @default(cuid())
  classLevel      String   @unique
  hourlyRate      Int
  sessionsPerWeek Int
  hoursPerSession Int
  updatedAt       DateTime @updatedAt
}

enum TutoringStatus {
  ACTIVE
  COMPLETED
  STOPPED
}

model Tutoring {
  id              String          @id @default(cuid())
  reference       String          @unique
  parentId        String
  parent          User            @relation("ParentTutorings", fields: [parentId], references: [id], onDelete: Restrict)
  educatorId      String
  educator        EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Restrict)
  childId         String
  child           Child           @relation(fields: [childId], references: [id], onDelete: Restrict)
  durationWeeks   Int
  startDate       DateTime
  endDate         DateTime
  status          TutoringStatus  @default(ACTIVE)
  // Instantané du tarif au moment de la création : une modification de la grille ne change pas un contrat en cours.
  classLevel      String
  hourlyRate      Int
  sessionsPerWeek Int
  hoursPerSession Int
  slotsLabel      String
  stoppedAt       DateTime?
  stopReason      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  bookedSlots  BookedSlot[]
  lessons      Lesson[]
  installments Installment[]
  review       Review?

  @@index([parentId])
  @@index([educatorId])
  @@index([status])
}

// Créneau réservé : la contrainte unique empêche deux tutorats actifs sur le même créneau d'un éducateur.
// Les lignes sont supprimées quand le tutorat se termine.
model BookedSlot {
  id         String          @id @default(cuid())
  tutoringId String
  tutoring   Tutoring        @relation(fields: [tutoringId], references: [id], onDelete: Cascade)
  educatorId String
  educator   EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  day        Weekday
  slot       TimeSlot

  @@unique([educatorId, day, slot])
}

enum LessonStatus {
  RECORDED
  CONFIRMED
  DISPUTED
}

model Lesson {
  id            String       @id @default(cuid())
  tutoringId    String
  tutoring      Tutoring     @relation(fields: [tutoringId], references: [id], onDelete: Cascade)
  date          DateTime     @db.Date
  slot          TimeSlot
  workDone      String
  observation   String?
  status        LessonStatus @default(RECORDED)
  parentComment String?
  confirmedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@unique([tutoringId, date, slot])
  @@index([tutoringId])
}

model Review {
  id         String          @id @default(cuid())
  tutoringId String          @unique
  tutoring   Tutoring        @relation(fields: [tutoringId], references: [id], onDelete: Cascade)
  parentId   String
  parent     User            @relation(fields: [parentId], references: [id], onDelete: Cascade)
  educatorId String
  educator   EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime        @default(now())

  @@index([educatorId])
}

// ---------------------------------------------------------------------------
// Paiements
// ---------------------------------------------------------------------------

enum InstallmentStatus {
  PENDING
  PAID
  CANCELLED
}

model Installment {
  id           String            @id @default(cuid())
  tutoringId   String
  tutoring     Tutoring          @relation(fields: [tutoringId], references: [id], onDelete: Cascade)
  index        Int
  weeks        Int
  amount       Int
  dueDate      DateTime
  status       InstallmentStatus @default(PENDING)
  reference    String            @unique
  paidAt       DateTime?
  remindedAt   DateTime?
  // Arrêt anticipé après paiement : part des semaines non effectuées à rembourser au parent.
  refundAmount Int?
  refundedAt   DateTime?
  refundedById String?
  refundedBy   User?             @relation("InstallmentRefunder", fields: [refundedById], references: [id], onDelete: SetNull)
  refundNote   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  payments Payment[]
  payout   Payout?

  @@unique([tutoringId, index])
  @@index([status, dueDate])
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
  FAILED
}

// Incohérence relevée au rapprochement, à traiter par un administrateur.
enum PaymentAnomaly {
  AMOUNT_MISMATCH
  DUPLICATE
}

// Encaissement parent via FedaPay. Une échéance peut avoir plusieurs tentatives, une seule approuvée.
// La tentative est enregistrée avant l'appel à FedaPay : son identifiant voyage dans les métadonnées de la transaction.
model Payment {
  id                    String          @id @default(cuid())
  installmentId         String
  installment           Installment     @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  payerId               String
  payer                 User            @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Restrict)
  amount                Int
  provider              String          @default("fedapay")
  providerTransactionId String?         @unique
  paymentUrl            String?
  status                PaymentStatus   @default(PENDING)
  statusReason          String?
  approvedAt            DateTime?
  anomaly               PaymentAnomaly?
  anomalyResolvedAt     DateTime?
  anomalyResolvedById   String?
  anomalyResolvedBy     User?           @relation("PaymentAnomalyResolver", fields: [anomalyResolvedById], references: [id], onDelete: SetNull)
  anomalyNote           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([installmentId])
  @@index([anomaly, anomalyResolvedAt])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum PayoutMethod {
  MANUAL
  FEDAPAY
}

// Reversement à l'éducateur, une fois l'échéance payée par le parent.
model Payout {
  id                String          @id @default(cuid())
  installmentId     String          @unique
  installment       Installment     @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  educatorId        String
  educator          EducatorProfile @relation(fields: [educatorId], references: [id], onDelete: Restrict)
  grossAmount       Int
  commissionAmount  Int
  netAmount         Int
  status            PayoutStatus    @default(PENDING)
  method            PayoutMethod?
  providerReference String?
  failureReason     String?
  // Lancement chez FedaPay ; executedAt n'est renseigné qu'une fois le versement confirmé.
  startedAt         DateTime?
  executedById      String?
  executedBy        User?           @relation("PayoutExecutor", fields: [executedById], references: [id], onDelete: SetNull)
  executedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([educatorId])
  @@index([providerReference])
}

// Événements webhook déjà traités : garantit l'idempotence.
model WebhookEvent {
  id         String   @id
  provider   String
  name       String
  receivedAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Réclamations et notifications
// ---------------------------------------------------------------------------

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model Complaint {
  id          String          @id @default(cuid())
  authorId    String
  author      User            @relation("ComplaintAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject     String
  details     String
  status      ComplaintStatus @default(OPEN)
  response    String?
  handledById String?
  handledBy   User?           @relation("ComplaintHandler", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([authorId])
  @@index([status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Suivi : un tuteur vérifie, pour le compte du parent, que les enfants font ce qui est attendu
// (leçons apprises, devoirs faits, notes consultées à l'école) et lui en fait un retour.
// ---------------------------------------------------------------------------

model TutorProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate       DateTime?
  zone            String?
  occupation      String?
  bio             String?
  guarantorName   String?
  guarantorPhone  String?
  payoutPhone     String?
  payoutOperator  MobileOperator?
  status          ProfileStatus   @default(INCOMPLETE)
  rejectionReason String?
  submittedAt     DateTime?
  validatedAt     DateTime?
  validatedById   String?
  validatedBy     User?           @relation("TutorValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  documents TutorDocument[]
  followUps FollowUp[]

  @@index([status])
}

model TutorDocument {
  id           String       @id @default(cuid())
  tutorId      String
  tutor        TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  type         DocumentType
  storageKey   String       @unique
  mimeType     String
  size         Int
  originalName String
  uploadedAt   DateTime     @default(now())

  @@unique([tutorId, type])
}

// REQUESTED : en attente de la réponse du tuteur ; DECLINED : refusé par le tuteur ; CANCELLED : demande retirée par le parent ;
// ENDED : suivi arrêté (par le parent, le tuteur ou Access).
enum FollowUpStatus {
  REQUESTED
  ACTIVE
  DECLINED
  CANCELLED
  ENDED
}

model FollowUp {
  id                String         @id @default(cuid())
  reference         String         @unique
  parentId          String
  parent            User           @relation("ParentFollowUps", fields: [parentId], references: [id], onDelete: Restrict)
  tutorId           String
  tutor             TutorProfile   @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  status            FollowUpStatus @default(REQUESTED)
  startDate         DateTime       @db.Date
  message           String?
  // Instantané de la grille au moment de la demande : un changement de tarif ne touche pas un suivi existant.
  monthlyPrice      Int
  commissionPercent Int
  respondedAt       DateTime?
  declineReason     String?
  endedAt           DateTime?
  endReason         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  children FollowUpChild[]
  tasks    FollowUpTask[]

  @@index([parentId])
  @@index([tutorId])
  @@index([status])
}

model FollowUpChild {
  followUpId String
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Restrict)

  @@id([followUpId, childId])
}

enum FollowUpTaskKind {
  LESSONS
  HOMEWORK
  SCHOOL_VISIT
  OTHER
}

// Action définie par le parent. Elle revient les jours choisis, une semaine sur `intervalWeeks`,
// et doit être faite avant `dueHour` (heure du Bénin) ; chaque passage donne une TaskOccurrence par enfant.
model FollowUpTask {
  id            String           @id @default(cuid())
  followUpId    String
  followUp      FollowUp         @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  kind          FollowUpTaskKind
  title         String
  instructions  String?
  childIds      String[]
  days          Weekday[]
  intervalWeeks Int              @default(1)
  dueHour       Int              @default(21)
  photoRequired Boolean          @default(false)
  // Une action retirée est désactivée, pas supprimée : ses retours passés restent consultables.
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())

  occurrences TaskOccurrence[]

  @@index([followUpId])
}

// PENDING : à faire ; MISSED : aucun retour dans le délai accordé (posé par la tâche quotidienne).
enum OccurrenceStatus {
  PENDING
  DONE
  PARTIAL
  NOT_DONE
  MISSED
}

model TaskOccurrence {
  id            String           @id @default(cuid())
  taskId        String
  task          FollowUpTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  childId       String
  child         Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  date          DateTime         @db.Date
  dueAt         DateTime
  status        OccurrenceStatus @default(PENDING)
  comment       String?
  // Notes relevées lors d'une visite à l'école : [{ subject, score, outOf }].
  grades        Json?
  reportedAt    DateTime?
  parentSeenAt  DateTime?
  parentComment String?
  createdAt     DateTime         @default(now())

  photos OccurrencePhoto[]

  @@unique([taskId, childId, date])
  @@index([status, dueAt])
  @@index([childId, date])
}

model OccurrencePhoto {
  id           String         @id @default(cuid())
  occurrenceId String
  occurrence   TaskOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  storageKey   String         @unique
  mimeType     String
  size         Int
  createdAt    DateTime       @default(now())

  @@index([occurrenceId])
}
