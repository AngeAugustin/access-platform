# --- Base de données (PostgreSQL) ---
DATABASE_URL="postgresql://access:access@localhost:5432/access?schema=public"

# --- Application ---
# URL publique de l'application (sert aux liens dans les e-mails et au retour de paiement)
APP_URL="http://localhost:3000"

# --- Paiement FedaPay ---
# Environnement : sandbox ou live
FEDAPAY_ENV="sandbox"
FEDAPAY_SECRET_KEY=""
# Secret de signature du webhook (tableau de bord FedaPay > Webhooks)
FEDAPAY_WEBHOOK_SECRET=""

# --- E-mails (Resend) ---
# Sans clé, les e-mails sont écrits dans la console (développement uniquement).
RESEND_API_KEY=""
MAIL_FROM="Access <no-reply@example.com>"

# --- Notifications push (VAPID) ---
# Générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@example.com"

# --- Stockage des pièces justificatives ---
# Dossier local hors de /public (en production : volume persistant)
STORAGE_DIR="./storage"

# --- Tâches planifiées ---
# Jeton exigé par /api/cron/daily (en-tête Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# --- Options avancées ---
# Opérateur Mobile Money des reversements FedaPay (mtn_open, moov, …)
FEDAPAY_PAYOUT_MODE="mtn_open"

# --- Initialisation (npm run db:seed) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NPI="0000000000"
SEED_ADMIN_PHONE="0100000000"

# --- Migration de l'ancienne base Symfony (npm run migrate:legacy) ---
LEGACY_MYSQL_URL=""
